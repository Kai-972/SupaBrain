{
  "name": "supabrain",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"!supabrain\" build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint:hardcode": "node scripts/check-hardcode.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "ens:verify": "tsx scripts/ens/verify-deployments.ts",
    "keys:new": "tsx scripts/keys-new.ts",
    "fund": "tsx scripts/fund.ts",
    "ens:register-team": "tsx scripts/ens/register-team.ts",
    "ens:deploy-registry": "tsx scripts/ens/deploy-team-registry.ts",
    "ens:add-agent": "tsx scripts/ens/add-agent.ts",
    "ens:prove": "tsx scripts/ens/prove-roles.ts",
    "ens:unregister": "tsx scripts/ens/unregister.ts",
    "ens:set-records": "tsx scripts/ens/set-records.ts",
    "ens:status": "tsx scripts/ens/status.ts",
    "vault:deploy": "tsx scripts/vault/deploy.ts",
    "vault:set-agents": "tsx scripts/vault/set-agents.ts",
    "vault:fund": "tsx scripts/vault/fund.ts",
    "vault:status": "tsx scripts/vault/status.ts",
    "vault:pay-proof": "tsx scripts/vault/pay-proof.ts",
    "vault:abi": "bash scripts/vault/gen-abi.sh",
    "demo:step-kill": "tsx scripts/demo/step-kill.ts",
    "arkiv:spike": "tsx scripts/arkiv/spike.ts",
    "arkiv:query": "tsx scripts/arkiv/query.ts",
    "mcp:token": "tsx scripts/keys/mcp-token.ts",
    "ens:add-vendor": "tsx scripts/ens/add-vendor.ts",
    "demo:step": "tsx scripts/demo/step.ts",
    "e2e:memory": "tsx scripts/demo/e2e-memory.ts",
    "dev:public": "bash scripts/dev-public.sh",
    "e2e:undo": "tsx scripts/demo/e2e-undo.ts",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "arkiv:reach": "tsx scripts/arkiv/reach.ts",
    "verify:memory": "tsx scripts/arkiv/verify-memory.ts",
    "e2e:continue": "tsx scripts/demo/e2e-continue.ts",
    "ens:provision-brains": "tsx scripts/ens/provision-brains.ts",
    "ens:brains-status": "tsx scripts/ens/brains-status.ts",
    "ens:brain-rules": "tsx scripts/ens/brain-rules.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
